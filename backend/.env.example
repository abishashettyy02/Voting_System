# Server
PORT=5000
NODE_ENV=development

# Mongo
MONGO_URI=mongodb://127.0.0.1:27017/secure_voting_demo

# JWT
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=2h

# Biometric simulation (demo-only)
BIOMETRIC_SALT=demo-biometric-salt

# CORS
# Comma-separated allowed origins (Vite uses 5173, and will try 5174 if 5173 is busy)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
